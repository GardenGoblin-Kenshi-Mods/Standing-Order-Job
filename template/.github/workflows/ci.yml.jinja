{% if include_ci %}
name: ci

on:
  push:
    branches: [main, master]
  pull_request:

jobs:
  layout:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Check scaffold files
        run: |
          test -f meitou.json
          test -f src/{{ assembly_name }}.csproj
          test -x tools/package.sh
          test -x tools/stage.sh
          python3 -m json.tool meitou.json >/dev/null

  # Optional Meitou build stays commented until MeitouClient is available in CI.
  # Uncomment inside a Jinja raw block if adding GitHub Actions expressions.
